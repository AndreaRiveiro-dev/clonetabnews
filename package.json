{
  "name": "clonetabnews",
  "version": "1.0.0",
  "description": "Criar um clone do https://www.tabnews.com.br/",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run service:up && next dev",
    "service:up": "docker compose -f infra/compose.yaml up -d",
    "service:stop": "docker compose -f infra/compose.yaml stop",
    "service:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
   "test": "NODE_OPTIONS=--experimental-vm-modules jest",
   "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "next": "^13.1.6",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.6.2"
  }
}
